# ===== aifreeforever-server 配置 =====
#
# 复制为 .env 后修改。

# API 主密钥。留空或设为 "1" 表示完全关闭鉴权。
API_MASTER_KEY=change-me-to-a-secure-key
# 鉴权模式：strict（默认）= 严格比对上面的 API_MASTER_KEY（防止误连/被扫）；
#          lenient = 任意 API Key 均可（仅本机自测方便时临时切换）
AUTH_MODE=strict

# 服务端口
PORT=8110

# 站点聊天页（CDP 桥 / 浏览器会话的目标页）
CHAT_PAGE=https://aifreeforever.com/chat/gpt-5-mini

# ==== 会话后端 ====
# CDP 桥（推荐）：附加到"用户手动过验证的干净 Edge 窗口"，窗口内页面 fetch 是唯一
# 稳定通过 Cloudflare 的通道（自动化窗口/直连均会被指纹检测 403，实测结论）。
# 设 0 则回退 Playwright 浏览器上下文后端。
CDP_PORT=9230

# 直连 HTTP 加速（默认关闭：cf_clearance 绑定浏览器 TLS 指纹，curl_cffi/httpx 直连 403）
USE_DIRECT_HTTP=false

# 外部 Turnstile 求解服务（可选；2captcha / CapMonster 等 AntiTurnstileTaskProxyLess 兼容 API）
# 用于图像 v2 通道（需 turnstile token）。留空则只用浏览器内采集。
TURNSTILE_SOLVER_URL=
TURNSTILE_SOLVER_KEY=

# 出口代理（可选；Playwright 备用后端使用；格式 http://user:pass@host:port）
OUTBOUND_PROXY=

# ==== 浏览器（备用后端 / 自动刷新 cookie）====
# 浏览器可执行文件路径（留空自动探测 Edge / Chrome 标准路径）
BROWSER_EXECUTABLE=

# 浏览器数据目录（持久化会话 + cookie 存储）
BROWSER_USER_DATA_DIR=./browser_data

# 浏览器上下文数量
BROWSER_CONTEXTS=2

# 是否无头运行。受 CDP 指纹检测影响，自动过验证不保证成功。
BROWSER_HEADLESS=false

# ==== 默认值 ====
DEFAULT_CHAT_MODEL=gpt-5-mini
DEFAULT_IMAGE_MODEL=gpt-image-2
DEFAULT_ASPECT_RATIO=1:1

# 请求上游超时（秒）
UPSTREAM_TIMEOUT=240

# 日志级别
LOG_LEVEL=INFO